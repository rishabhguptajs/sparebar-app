# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (prepaid billing must be on)
GEMINI_API_KEY=

# Cloudflare R2 (private bucket + API token with Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sparebar-media

# Shared secret for /api/cron/tick, also pasted into supabase/setup/cron.sql
# Generate with: openssl rand -hex 32
CRON_SECRET=
