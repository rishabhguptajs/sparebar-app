# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter runs almost every model. Create a key at openrouter.ai/keys and add credits.
OPENROUTER_API_KEY=

# Google AI Studio, used only for Gemini Omni (not on OpenRouter) and the caption kit. Prepaid billing must be on.
GEMINI_API_KEY=

# Cloudflare R2 (private bucket + API token with Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sparebar-media

# Shared secret for /api/cron/tick, also pasted into supabase/setup/cron.sql
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Dodo Payments (Developers > API Keys and Webhooks). Mode is test or live.
# Webhook URL: <site>/api/dodo/webhook, events payment.succeeded, payment.failed, refund.succeeded.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_MODE=test
# One product per plan and pack, created in the Dodo dashboard at the USD price in src/config/plans.ts.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_STUDIO=
DODO_PRODUCT_PACK_100=
DODO_PRODUCT_PACK_270=
DODO_PRODUCT_PACK_560=

# Free tier abuse checks. ABUSE_SALT is a random secret used to hash device and network values.
# Generate with: openssl rand -hex 32. Free credits stay off until it is set.
ABUSE_SALT=
# Set to false to pause new free grants (for example when a lab balance is low).
FREE_CREDITS_ENABLED=true
# Set to true to close sign in, the app and paid actions (for example until live payment keys exist).
SIGNIN_PAUSED=false

# Where lab balance alerts are posted. A Slack or Discord incoming webhook URL works. Optional.
ALERT_WEBHOOK_URL=

# Lab API keys. Add each when you fund that lab, then set enabled: true on its models in src/config/models.ts.
XAI_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
# Alibaba host for your workspace, for example https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com
ALIBABA_BASE_URL=


# Search engine ownership checks (optional). Paste the token from Search Console and Bing Webmaster.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Analytics (optional). Create a project at posthog.com and paste its project key. Empty means nothing is sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
