# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (prepaid billing must be on)
GEMINI_API_KEY=

# Cloudflare R2 (private bucket + API token with Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sparebar-media

# Shared secret for /api/cron/tick, also pasted into supabase/setup/cron.sql
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Razorpay (Dashboard > Account & Settings > API keys, and Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rupees per US dollar, used to price Indian checkout. Leave empty to turn Indian checkout off.
INR_PER_USD=
# Seller GST details, shown on invoices. State code is the 2 digit GST code (27 is Maharashtra).
SELLER_STATE_CODE=
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_LUT_NUMBER=

# Free tier abuse checks. ABUSE_SALT is a random secret used to hash device and network values.
# Generate with: openssl rand -hex 32. Free credits stay off until it is set.
ABUSE_SALT=
# Set to false to pause new free grants (for example when a lab balance is low).
FREE_CREDITS_ENABLED=true

# Where lab balance alerts are posted. A Slack or Discord incoming webhook URL works. Optional.
ALERT_WEBHOOK_URL=
